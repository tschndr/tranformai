DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Higher-quality model for subscribers (paid upgrade). Defaults to claude-sonnet-5.
ANTHROPIC_MODEL_PREMIUM=claude-sonnet-5
IP_HASH_SALT=

# Auth.js (NextAuth) — generate a secret with: npx auth secret
AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Rewrite Anything <onboarding@resend.dev>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Subscription prices (recurring): $8/mo and $64/yr
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# One-time credit-pack prices: 100/$6, 300/$15, 1000/$40
STRIPE_PRICE_ID_CREDITS_SMALL=
STRIPE_PRICE_ID_CREDITS_MEDIUM=
STRIPE_PRICE_ID_CREDITS_LARGE=

# Public app URL, used for Stripe redirect/return URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
